{
  "name": "multipage-template",
  "version": "1.1.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack-dev-server --config build/webpack.dev.config.js",
    "build": "cross-env NODE_ENV=production node build/build.js",
    "release:dev": "aliyunoss-cli --releaseEnv dev",
    "release:pre": "aliyunoss-cli --releaseEnv pre",
    "release:prd": "aliyunoss-cli --releaseEnv prd",
    "publish:dev": "npm i && npm run build && npm run release:dev",
    "publish:pre": "npm i && npm run build && npm run release:pre",
    "publish:prd": "npm i && npm run build && npm run release:prd",
    "lint:fix": "eslint ./src/**/*.js --ext 'js' --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengchuu/multipage-template.git"
  },
  "keywords": [
    "multip",
    "page",
    "webpack"
  ],
  "author": "Cheng",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chengchuu/multipage-template/issues"
  },
  "homepage": "https://github.com/chengchuu/multipage-template#readme",
  "devDependencies": {
    "@babel/core": "^7.11.4",
    "@babel/plugin-proposal-class-properties": "^7.10.4",
    "@babel/plugin-transform-runtime": "^7.11.0",
    "@babel/preset-env": "^7.11.0",
    "@commitlint/cli": "^9.1.2",
    "@commitlint/config-conventional": "^13.0.0",
    "aliyunoss-cli": "^1.1.1",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.1.0",
    "chalk": "^4.1.0",
    "cross-env": "^7.0.2",
    "css-loader": "^5.2.6",
    "date-fns": "^2.21.3",
    "eslint": "^7.7.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "friendly-errors-webpack-plugin": "^1.7.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^4.3.8",
    "lint-staged": "^10.2.11",
    "mini-css-extract-plugin": "^2.6.1",
    "node-notifier": "^8.0.1",
    "optimize-css-assets-webpack-plugin": "^6.0.0",
    "ora": "^5.0.0",
    "prettier": "^2.0.5",
    "prettier-eslint-cli": "^5.0.0",
    "sass": "^1.50.1",
    "sass-loader": "^9.0.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.11.1",
    "webpack-merge": "^5.8.0",
    "workbox-webpack-plugin": "^6.5.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.11.2",
    "@babel/runtime-corejs2": "^7.11.2",
    "@babel/runtime-corejs3": "^7.11.2"
  }
}
